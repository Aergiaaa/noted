# Production Caddyfile: auto-HTTPS via ACME.
# Set APP_ORIGIN_HOST in .env (e.g. noted.example.com).
# Caddy reads $APP_ORIGIN_HOST from the environment.

{$APP_ORIGIN_HOST} {
	encode zstd gzip
	reverse_proxy web:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
	}
}
