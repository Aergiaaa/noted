# Copy to .env (never commit .env). Generate secrets with:
#   openssl rand -base64 32
APP_ENV=dev
APP_ORIGIN=http://localhost:5173
TZ=UTC
DB_PATH=/data/noted.db
CURRENCY_DEFAULT=USD
TOTP_ENC_KEY=
TRUSTED_PROXIES=
# Production TLS: set to your domain (e.g. noted.example.com).
# Caddy uses this for automatic HTTPS.
APP_ORIGIN_HOST=
# Bind address (:8080). Must match the api healthcheck URL in compose.
ADDR=:8080
