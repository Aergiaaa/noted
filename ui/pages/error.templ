package pages

import (
	"github.com/Aergiaaa/noted/ui/components/button"
	"github.com/Aergiaaa/noted/ui/layouts"
	"strconv"
)

templ Error(code int, msg string) {
	@layouts.Auth() {
		<div class="flex flex-col items-center justify-center h-screen">
			<h1 class="text-4xl font-bold">{ strconv.Itoa(code) }</h1>
			<p class="text-gray-500">{ msg }</p>
			@button.Button(button.Props{
				Href: "/",
			}) {
				go home
			}
		</div>
	}
}
