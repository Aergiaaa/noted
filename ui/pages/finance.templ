package pages

import (
	"encoding/json"
	"fmt"
	"strconv"

	database "github.com/Aergiaaa/noted/internal/database"
	"github.com/jackc/pgx/v5/pgtype"
)

templ TagPagesView(name, tagId string, pages []database.GetPagePaginatedRow) {
	<div class="relative mx-auto w-full max-w-2xl px-4 py-8">
		<button
			@click={ "deleteTag('" + tagId + "')" }
			title="delete tag"
			class="absolute top-8 right-4 cursor-pointer rounded-lg border border-zinc-800 px-2 py-1 text-xs text-zinc-500 hover:border-red-500 hover:text-red-400"
		>Delete</button>
		<h1 class="mb-8 text-4xl font-bold tracking-tight">Tag: { name }</h1>
		<div class="space-y-1">
			for _, p := range pages {
				<button
					@click={ "loadContent('" + p.ID.String() + "')" }
					class="block text-sm text-zinc-400 hover:text-white transition-colors duration-100"
				>{ p.Title }</button>
			}
			if len(pages) == 0 {
				<p class="text-sm text-zinc-600">No pages with this tag</p>
			}
		</div>
	</div>
}

templ PocketView(pockets []database.GetPocketBalancesRow, summary database.GetMonthlySummaryRow) {
	<div x-data="pocketView()" class="mx-auto w-full max-w-2xl px-4 py-8">
		<h1 class="mb-8 text-4xl font-bold tracking-tight">Pockets</h1>
		<div class="mb-8 grid grid-cols-3 gap-3">
			<div class="rounded-lg border border-zinc-800 p-4">
				<p class="text-xs uppercase tracking-wider text-zinc-500">Income</p>
				<p class="mt-1 text-lg font-semibold text-emerald-400">+{ money(summary.Income) }</p>
			</div>
			<div class="rounded-lg border border-zinc-800 p-4">
				<p class="text-xs uppercase tracking-wider text-zinc-500">Expense</p>
				<p class="mt-1 text-lg font-semibold text-red-400">-{ money(summary.Expense) }</p>
			</div>
			<div class="rounded-lg border border-zinc-800 p-4">
				<p class="text-xs uppercase tracking-wider text-zinc-500">Net</p>
				<p class={ "mt-1 text-lg font-semibold " + moneyColor(netAmount(summary)) }>{ signedNet(netAmount(summary)) }</p>
			</div>
		</div>
		<div class="overflow-hidden rounded-lg border border-zinc-800">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-zinc-800 text-left text-xs uppercase tracking-wider text-zinc-500">
						<th class="px-4 py-2">Pocket</th>
						<th class="px-4 py-2">Type</th>
						<th class="px-4 py-2 text-right">Balance</th>
						<th class="px-2 py-2"></th>
					</tr>
				</thead>
				<tbody>
					for _, p := range pockets {
						<tr data-row={ pocketRowData(p) } class="border-b border-zinc-800/50 last:border-b-0">
							<td class="px-4 py-2 text-zinc-200">{ p.Name }</td>
							<td class="px-4 py-2 text-zinc-500">{ p.Type }</td>
							<td class={ "px-4 py-2 text-right " + moneyColor(p.Balance) }>{ money(p.Balance) }</td>
							<td class="px-2 py-2 text-right whitespace-nowrap">
								<button
									@click="edit($event)"
									class="cursor-pointer text-zinc-600 hover:text-zinc-300 transition-colors duration-100"
								>Edit</button>
								<button
									@click={ "remove('" + p.ID.String() + "')" }
									class="ml-2 cursor-pointer text-zinc-600 hover:text-red-400 transition-colors duration-100"
								>×</button>
							</td>
						</tr>
					}
					if len(pockets) == 0 {
						<tr>
							<td colspan="4" class="px-4 py-8 text-center text-zinc-600">No pockets yet</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<form @submit.prevent="add()" class="mt-6 flex gap-2">
			<input
				x-ref="nameInput"
				type="text"
				placeholder="Pocket name"
				class="flex-1 rounded-lg border border-zinc-800 bg-transparent px-3 py-2 text-sm outline-none focus:border-zinc-600"
			/>
			<select
				x-ref="typeSelect"
				class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm text-zinc-300 outline-none focus:border-zinc-600"
			>
				<option value="cash">Cash</option>
				<option value="bank">Bank</option>
				<option value="ewallet">E-Wallet</option>
			</select>
			<button type="submit" class="cursor-pointer rounded-lg border border-zinc-700 px-4 py-2 text-sm text-zinc-300 hover:border-zinc-500 hover:text-white transition-colors duration-100">
					<span x-show="!editing">Add</span>
					<span x-show="editing">Save</span>
				</button>
				<button type="button" @click="cancelEdit()" x-show="editing" class="cursor-pointer rounded-lg border border-zinc-700 px-4 py-2 text-sm text-zinc-500 hover:border-zinc-500 hover:text-white transition-colors duration-100">
					Cancel
				</button>
			</form>
	</div>
}

templ TransactionView(transactions []database.GetTransactionsWithPocketNamesRow, tags map[string][]database.GetTagsByTargetRow, pockets []database.GetAllPocketsRow) {
	<div x-data="transactionForm()" class="mx-auto w-full max-w-2xl px-4 py-8">
		<h1 class="mb-8 text-4xl font-bold tracking-tight">Transactions</h1>

		<form @submit.prevent="filter()" class="mb-8 rounded-lg border border-zinc-800 p-4">
			<div class="flex flex-wrap items-center gap-2">
				<select x-ref="filterPocket" class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs text-zinc-300 outline-none focus:border-zinc-600">
					<option value="">All pockets</option>
					@pocketOptions(pockets)
				</select>
				<input
					x-ref="filterFrom"
					type="date"
					class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs text-zinc-300 outline-none focus:border-zinc-600"
				/>
				<span class="text-xs text-zinc-600">to</span>
				<input
					x-ref="filterTo"
					type="date"
					class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs text-zinc-300 outline-none focus:border-zinc-600"
				/>
				<button type="submit" class="ml-auto cursor-pointer rounded-lg border border-zinc-700 px-4 py-1.5 text-xs text-zinc-300 hover:border-zinc-500 hover:text-white transition-colors duration-100">
					Filter
				</button>
				<button type="button" @click="clearFilter()" class="cursor-pointer rounded-lg border border-zinc-700 px-4 py-1.5 text-xs text-zinc-500 hover:border-zinc-500 hover:text-white transition-colors duration-100">
					Clear
				</button>
			</div>
		</form>

		<form @submit.prevent="create()" class="mb-8 rounded-lg border border-zinc-800 p-4">
			<div class="flex gap-2">
				<input
					x-ref="titleInput"
					type="text"
					placeholder="Title"
					class="flex-1 rounded-lg border border-zinc-800 bg-transparent px-3 py-2 text-sm outline-none focus:border-zinc-600"
				/>
				<input
					x-ref="amountInput"
					type="number"
					step="0.01"
					placeholder="Amount"
					class="w-36 rounded-lg border border-zinc-800 bg-transparent px-3 py-2 text-sm outline-none focus:border-zinc-600"
				/>
				<input
					x-ref="dateInput"
					type="date"
					class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-2 text-sm text-zinc-300 outline-none focus:border-zinc-600"
				/>
			</div>
			<div class="mt-3 flex flex-wrap items-center gap-2">
				<div class="flex overflow-hidden rounded-lg border border-zinc-800">
					<button type="button" @click="setType('income')" :class="typeClass('income')" class="px-3 py-1.5 text-xs cursor-pointer transition-colors duration-100">Income</button>
					<button type="button" @click="setType('expense')" :class="typeClass('expense')" class="px-3 py-1.5 text-xs cursor-pointer transition-colors duration-100">Expense</button>
					<button type="button" @click="setType('transfer')" :class="typeClass('transfer')" class="px-3 py-1.5 text-xs cursor-pointer transition-colors duration-100">Transfer</button>
				</div>
				<select x-show="type !== 'income'" x-ref="fromSelect" class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs text-zinc-300 outline-none focus:border-zinc-600">
					<option value="">From pocket</option>
					@pocketOptions(pockets)
				</select>
				<select x-show="type !== 'expense'" x-ref="toSelect" class="rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs text-zinc-300 outline-none focus:border-zinc-600">
					<option value="">To pocket</option>
					@pocketOptions(pockets)
				</select>
<button type="submit" class="ml-auto cursor-pointer rounded-lg border border-zinc-700 px-4 py-1.5 text-xs text-zinc-300 hover:border-zinc-500 hover:text-white transition-colors duration-100">
				<span x-show="!editing">Add</span>
				<span x-show="editing">Save</span>
			</button>
			<button type="button" @click="cancelEdit()" x-show="editing" class="cursor-pointer rounded-lg border border-zinc-700 px-4 py-1.5 text-xs text-zinc-500 hover:border-zinc-500 hover:text-white transition-colors duration-100">
				Cancel
			</button>
			</div>
		</form>

		<div class="overflow-hidden rounded-lg border border-zinc-800">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-zinc-800 text-left text-xs uppercase tracking-wider text-zinc-500">
						<th class="px-4 py-2">Title</th>
						<th class="px-4 py-2">Pocket</th>
						<th class="px-4 py-2">Date</th>
						<th class="px-4 py-2 text-right">Amount</th>
						<th class="px-2 py-2"></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range transactions {
						<tr data-row={ transactionRowData(t) } class="border-b border-zinc-800/50 last:border-b-0">
							<td class="px-4 py-2 text-zinc-200">{ t.Title }</td>
							<td class="px-4 py-2 text-zinc-500">{ pocketLabel(t) }</td>
							<td class="px-4 py-2 text-zinc-500">{ t.Date.Time.Format("2006-01-02") }</td>
							<td class={ "px-4 py-2 text-right " + amountColor(t.Type) }>{ signedAmount(t.Type, t.Amount) }</td>
							<td class="px-2 py-2 text-right whitespace-nowrap">
								<button
									@click="edit($event)"
									class="cursor-pointer text-zinc-600 hover:text-zinc-300 transition-colors duration-100"
								>Edit</button>
								<button
									@click={ "remove('" + t.ID.String() + "')" }
									class="ml-2 cursor-pointer text-zinc-600 hover:text-red-400 transition-colors duration-100"
								>×</button>
							</td>
						</tr>
						<tr x-data={ transactionTagsProps(t.ID.String()) } class="border-b border-zinc-800/50 last:border-b-0">
							<td colspan="5" class="px-4 py-1">
								<div class="flex flex-wrap items-center gap-2">
									for _, tag := range tags[t.ID.String()] {
										<span
											class="flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium"
											style={ "background-color: " + tag.Color + "33" }
										>
											{ tag.Name }
											<button
												@click={ "detach('" + tag.ID.String() + "')" }
												title="remove tag"
												class="ml-1 cursor-pointer rounded-full px-1 leading-none opacity-60 hover:opacity-100"
											>×</button>
										</span>
									}
									<input
										x-show="adding"
										x-ref="tagInput"
										type="text"
										placeholder="Tag name"
										@keydown.enter="add()"
										@blur="adding = false"
										class="rounded-full border border-zinc-800 bg-transparent px-3 py-0.5 text-xs outline-none focus:border-zinc-600"
									/>
									<button
										@click="toggleAdd()"
										title="add tag"
										class="cursor-pointer rounded-full border border-dashed border-zinc-700 px-2 py-0.5 text-xs text-zinc-500 hover:border-zinc-500 hover:text-zinc-300"
									>+</button>
								</div>
							</td>
						</tr>
					}
					if len(transactions) == 0 {
						<tr>
							<td colspan="5" class="px-4 py-8 text-center text-zinc-600">No transactions yet</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ TrashView(pockets []database.GetDeletedPocketsRow, transactions []database.GetDeletedTransactionsRow) {
	<div x-data="trashView()" class="mx-auto w-full max-w-2xl px-4 py-8">
		<h1 class="mb-8 text-4xl font-bold tracking-tight">Trash</h1>
		<div class="overflow-hidden rounded-lg border border-zinc-800">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-zinc-800 text-left text-xs uppercase tracking-wider text-zinc-500">
						<th class="px-4 py-2">Pocket</th>
						<th class="px-4 py-2">Type</th>
						<th class="px-4 py-2">Deleted</th>
						<th class="px-2 py-2"></th>
					</tr>
				</thead>
				<tbody>
					for _, p := range pockets {
						<tr class="border-b border-zinc-800/50 last:border-b-0">
							<td class="px-4 py-2 text-zinc-200">{ p.Name }</td>
							<td class="px-4 py-2 text-zinc-500">{ p.Type }</td>
							<td class="px-4 py-2 text-zinc-500">{ p.DeletedAt.Time.Format("2006-01-02") }</td>
							<td class="px-2 py-2 text-right">
								<button
									@click={ "restorePocket('" + p.ID.String() + "')" }
									class="cursor-pointer text-zinc-600 hover:text-emerald-400 transition-colors duration-100"
								>Restore</button>
							</td>
						</tr>
					}
					if len(pockets) == 0 {
						<tr>
							<td colspan="4" class="px-4 py-8 text-center text-zinc-600">No deleted pockets</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="mt-6 overflow-hidden rounded-lg border border-zinc-800">
			<table class="w-full text-sm">
				<thead>
					<tr class="border-b border-zinc-800 text-left text-xs uppercase tracking-wider text-zinc-500">
						<th class="px-4 py-2">Title</th>
						<th class="px-4 py-2">Date</th>
						<th class="px-4 py-2 text-right">Amount</th>
						<th class="px-2 py-2"></th>
					</tr>
				</thead>
				<tbody>
					for _, t := range transactions {
						<tr class="border-b border-zinc-800/50 last:border-b-0">
							<td class="px-4 py-2 text-zinc-200">{ t.Title }</td>
							<td class="px-4 py-2 text-zinc-500">{ t.Date.Time.Format("2006-01-02") }</td>
							<td class={ "px-4 py-2 text-right " + amountColor(t.Type) }>{ signedAmount(t.Type, t.Amount) }</td>
							<td class="px-2 py-2 text-right">
								<button
									@click={ "restoreTransaction('" + t.ID.String() + "')" }
									class="cursor-pointer text-zinc-600 hover:text-emerald-400 transition-colors duration-100"
								>Restore</button>
							</td>
						</tr>
					}
					if len(transactions) == 0 {
						<tr>
							<td colspan="4" class="px-4 py-8 text-center text-zinc-600">No deleted transactions</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

templ pocketOptions(pockets []database.GetAllPocketsRow) {
	for _, p := range pockets {
		<option value={ p.ID.String() }>{ p.Name }</option>
	}
}

func money(n pgtype.Numeric) string {
	f, err := n.Float64Value()
	if err != nil {
		return ""
	}

	return fmt.Sprintf("%.2f", f.Float64)
}

func signedAmount(t string, n pgtype.Numeric) string {
	f, err := n.Float64Value()
	if err != nil {
		return ""
	}

	if t == "expense" {
		return "-" + fmt.Sprintf("%.2f", f.Float64)
	}

	return "+" + fmt.Sprintf("%.2f", f.Float64)
}

func moneyColor(n pgtype.Numeric) string {
	f, err := n.Float64Value()
	if err != nil {
		return "text-zinc-400"
	}

	if f.Float64 < 0 {
		return "text-red-400"
	}

	return "text-emerald-400"
}

func amountColor(t string) string {
	if t == "expense" {
		return "text-red-400"
	}

	return "text-emerald-400"
}

func netAmount(s database.GetMonthlySummaryRow) pgtype.Numeric {
	income, err := s.Income.Float64Value()
	if err != nil {
		return pgtype.Numeric{}
	}

	expense, err := s.Expense.Float64Value()
	if err != nil {
		return pgtype.Numeric{}
	}

	var net pgtype.Numeric
	_ = net.Scan(fmt.Sprintf("%.2f", income.Float64-expense.Float64))

	return net
}

func signedNet(n pgtype.Numeric) string {
	f, err := n.Float64Value()
	if err != nil {
		return ""
	}

	if f.Float64 < 0 {
		return fmt.Sprintf("%.2f", f.Float64)
	}

	return "+" + fmt.Sprintf("%.2f", f.Float64)
}

func pocketLabel(t database.GetTransactionsWithPocketNamesRow) string {
	switch {
	case t.FromPocketName.Valid && t.ToPocketName.Valid:
		return t.FromPocketName.String + " → " + t.ToPocketName.String
	case t.FromPocketName.Valid:
		return t.FromPocketName.String
	case t.ToPocketName.Valid:
		return t.ToPocketName.String
	default:
		return "—"
	}
}

func transactionTagsProps(id string) string {
	return "transactionTags({id: " + strconv.Quote(id) + "})"
}

type pocketRowJSON struct {
	ID   string `json:"id"`
	Name string `json:"name"`
	Type string `json:"type"`
}

func pocketRowData(p database.GetPocketBalancesRow) string {
	row := pocketRowJSON{
		ID:   p.ID.String(),
		Name: p.Name,
		Type: p.Type,
	}

	b, _ := json.Marshal(row)
	return string(b)
}

type transactionRowJSON struct {
	ID     string  `json:"id"`
	Title  string  `json:"title"`
	Type   string  `json:"type"`
	Amount float64 `json:"amount"`
	Date   string  `json:"date"`
	From   string  `json:"from"`
	To     string  `json:"to"`
}

func transactionRowData(t database.GetTransactionsWithPocketNamesRow) string {
	amount, err := t.Amount.Float64Value()
	if err != nil {
		amount.Float64 = 0
	}

	row := transactionRowJSON{
		ID:     t.ID.String(),
		Title:  t.Title,
		Type:   t.Type,
		Amount: amount.Float64,
		Date:   t.Date.Time.Format("2006-01-02"),
	}

	if t.FromPocketID.Valid {
		row.From = t.FromPocketID.String()
	}

	if t.ToPocketID.Valid {
		row.To = t.ToPocketID.String()
	}

	b, _ := json.Marshal(row)
	return string(b)
}