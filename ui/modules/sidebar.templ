package modules

templ SideBar() {
	<div
		x-show="sidebarOpen"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="-translate-x-full"
		x-transition:enter-end="translate-x-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="translate-x-0"
		x-transition:leave-end="-translate-x-full"
		class="fixed top-0 left-0 z-50 flex flex-col h-full w-72 bg-zinc-900 border-r border-zinc-800 shadow-2xl"
	>
		<div class="flex-1 overflow-y-auto py-2">
			<p class="px-4 py-2 text-xs uppercase tracking-wider text-zinc-600">Pages</p>
			<input
				x-ref="searchInput"
				type="text"
				placeholder="Search pages..."
				@input="search()"
				@keydown.escape="clearSearch()"
				class="mx-4 mb-1 w-[calc(100%-2rem)] rounded-lg border border-zinc-800 bg-transparent px-3 py-1.5 text-sm outline-none focus:border-zinc-600"
			/>
			<template x-for="page in pages" :key="page.id">
				<div
					@click="loadContent(page.id)"
					:class="activePageId === page.id ? 'bg-zinc-700 text-white' : 'text-zinc-400 hover:bg-zinc-800 hover:text-white'"
					class="px-4 py-2 text-sm cursor-pointer truncate transition-colors duration-100"
					x-text="page.title"
				></div>
			</template>
			<p class="px-4 py-2 pt-6 text-xs uppercase tracking-wider text-zinc-600">Finance</p>
			<div
				@click="loadFinance('pockets')"
				:class="view === 'pockets' ? 'bg-zinc-700 text-white' : 'text-zinc-400 hover:bg-zinc-800 hover:text-white'"
				class="px-4 py-2 text-sm cursor-pointer truncate transition-colors duration-100"
			>Pockets</div>
			<div
				@click="loadFinance('transactions')"
				:class="view === 'transactions' ? 'bg-zinc-700 text-white' : 'text-zinc-400 hover:bg-zinc-800 hover:text-white'"
				class="px-4 py-2 text-sm cursor-pointer truncate transition-colors duration-100"
			>Transactions</div>
			<div
				@click="loadFinance('trash')"
				:class="view === 'trash' ? 'bg-zinc-700 text-white' : 'text-zinc-400 hover:bg-zinc-800 hover:text-white'"
				class="px-4 py-2 text-sm cursor-pointer truncate transition-colors duration-100"
			>Trash</div>
		</div>
		<div class="flex items-center gap-1 px-4 py-3 border-t border-zinc-800">
			<template x-for="n in totalPages" :key="n">
				<button
					@click="fetchPages(n)"
					:class="n === currentPaginationPage ? 'bg-zinc-600 text-white' : 'text-zinc-400 hover:bg-zinc-700 hover:text-white'"
					class="w-7 h-7 text-xs rounded transition-colors duration-100"
					x-text="n"
				></button>
			</template>
		</div>
	</div>
}

