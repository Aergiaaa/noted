package modules

templ Navbar() {
	<nav
		x-show="navbarVisible"
		class="flex items-center justify-between px-2 py-2 sticky top-0"
	>
		<div class="flex items-baseline gap-3">
			<button
				@click="sidebarOpen = !sidebarOpen"
				title="toggle sidebar"
				class="text-zinc-400 hover:text-white transition-colors duration-100 text-xl px-2"
			>☰</button>
			<div class="text-3xl font-bold">Noted</div>
			<button
				@click="createPage()"
				class="text-zinc-400 hover:text-white transition-colors duration-100 text-xl px-2"
			>+</button>
		</div>
		@LogoutButton()
	</nav>
}
