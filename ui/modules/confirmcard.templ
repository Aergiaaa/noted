package modules

templ ConfirmCard() {
	<div
		x-show="confirmCard"
		@keydown.escape.window="cancelDelete()"
		class="fixed inset-0 z-50 flex items-center justify-center"
	>
		<div
			@click="cancelDelete()"
			class="absolute inset-0 bg-black/50"
		></div>
		<div class="relative w-80 rounded-xl border border-zinc-800 bg-zinc-950 p-5 shadow-2xl">
			<p class="text-sm text-zinc-200" x-text="confirmCard?.message"></p>
			<div class="mt-5 flex justify-end gap-2">
				<button
					@click="cancelDelete()"
					class="cursor-pointer rounded-lg border border-zinc-700 px-3 py-1.5 text-sm text-zinc-300 hover:border-zinc-500 hover:text-white transition-colors duration-100"
				>Cancel</button>
				<button
					@click="doDelete()"
					class="cursor-pointer rounded-lg border border-red-800 px-3 py-1.5 text-sm text-red-400 hover:border-red-500 hover:text-red-300 transition-colors duration-100"
				>Delete</button>
			</div>
		</div>
	</div>
}