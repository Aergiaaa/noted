package modules

import (
	"encoding/json"
	"strconv"

	"github.com/Aergiaaa/noted/internal/database"
	"github.com/jackc/pgx/v5/pgtype"
)

templ PageView(title, pageId string, blocks []database.GetBlocksByPageRow) {
	<div class="mx-auto w-full max-w-2xl px-4 py-8">
		<h1 class="mb-8 text-4xl font-bold tracking-tight">{ title }</h1>
		<div class="space-y-1">
			@blockTree(blocks, pgtype.UUID{}, 0, pageId)
		</div>
	</div>
}

templ blockTree(blocks []database.GetBlocksByPageRow, parentId pgtype.UUID, depth int, pageId string) {
	for _, b := range blockChildren(blocks, parentId) {
		@blockEditor(b, pageId, depth)
		@blockTree(blocks, b.ID, depth+1, pageId)
	}
}

templ blockEditor(b database.GetBlocksByPageRow, pageId string, depth int) {
	<div
		x-data={ editorProps(b, pageId) }
		contenteditable="true"
		spellcheck="false"
		@input="onInput()"
		@keydown="onKeydown($event)"
		class={ editorClass(b.Type, depth) }
	>
		{ blockText(b.Content) }
	</div>
}

func blockChildren(blocks []database.GetBlocksByPageRow, parentId pgtype.UUID) []database.GetBlocksByPageRow {
	var children []database.GetBlocksByPageRow

	for _, b := range blocks {
		if b.ParentBlockID == parentId {
			children = append(children, b)
		}
	}

	return children
}

func blockText(content []byte) string {
	var c struct {
		Text string `json:"text"`
	}
	if err := json.Unmarshal(content, &c); err != nil {
		return ""
	}

	return c.Text
}

func editorProps(b database.GetBlocksByPageRow, pageId string) string {
	return "editor({id: " + strconv.Quote(b.ID.String()) + ", type: " + strconv.Quote(b.Type) + ", pageId: " + strconv.Quote(pageId) + "})"
}

func editorClass(t string, depth int) string {
	base := "outline-none cursor-text py-0.5"

	if depth > 0 {
		base += " ml-6"
	}

	if t == "heading" {
		return base + " pt-3 text-2xl font-semibold"
	}

	return base
}