package modules

import (
	"encoding/json"
	"fmt"
	"regexp"
	"strconv"
	"strings"

	"github.com/Aergiaaa/noted/internal/database"
	"github.com/jackc/pgx/v5/pgtype"
)

templ PageView(title, pageId string, blocks []database.GetBlocksByPageRow, tags []database.GetTagsByTargetRow, backlinks []database.GetBacklinkPagesRow, pages map[string]string, balances []database.GetPocketBalancesRow, txByPocket map[string][]database.GetTransactionsWithPocketNamesRow) {
	<div x-data={ pageTagsProps(pageId) } class="relative mx-auto w-full max-w-2xl px-4 py-8">
		<button
			@click={ "deletePage('" + pageId + "')" }
			title="delete page"
			class="absolute top-8 right-4 cursor-pointer rounded-lg border border-zinc-800 px-2 py-1 text-xs text-zinc-500 hover:border-red-500 hover:text-red-400"
		>Delete</button>
		<h1
			x-data={ pageTitleProps(pageId, title) }
			contenteditable="true"
			spellcheck="false"
			data-placeholder="Untitled"
			@input="onInput()"
			@keydown="onKeydown($event)"
			@blur="onBlur()"
			class="page-title mb-8 cursor-text text-4xl font-bold tracking-tight outline-none"
		>{ title }</h1>
		@tagPills(tags, pageId)
		<div class="space-y-1">
			@blockTree(blocks, pgtype.UUID{}, 0, pageId, pages, balances, txByPocket)
		</div>
		@backlinkList(backlinks)
	</div>
}

templ tagPills(tags []database.GetTagsByTargetRow, pageId string) {
	<div class="mb-6 flex flex-wrap items-center gap-2">
		for _, t := range tags {
			<span
				class="flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium"
				style={ "background-color: " + t.Color + "33" }
			>
				{ t.Name }
				<button
					@click={ "detach('" + t.ID.String() + "')" }
					title="remove tag"
					class="ml-1 cursor-pointer rounded-full px-1 leading-none opacity-60 hover:opacity-100"
				>×</button>
			</span>
		}
		<input
			x-show="adding"
			x-ref="tagInput"
			type="text"
			placeholder="Tag name"
			@keydown.enter="add()"
			@blur="adding = false"
			class="rounded-full border border-zinc-800 bg-transparent px-3 py-0.5 text-xs outline-none focus:border-zinc-600"
		/>
		<button
			@click="toggleAdd()"
			title="add tag"
			class="cursor-pointer rounded-full border border-dashed border-zinc-700 px-2 py-0.5 text-xs text-zinc-500 hover:border-zinc-500 hover:text-zinc-300"
		>+</button>
	</div>
}

templ backlinkList(backlinks []database.GetBacklinkPagesRow) {
	if len(backlinks) > 0 {
		<div class="mt-12 border-t border-zinc-800 pt-6">
			<p class="mb-3 text-sm text-zinc-500">Backlinks</p>
			<div class="space-y-1">
				for _, b := range backlinks {
					<button
						@click={ "loadContent('" + b.ID.String() + "')" }
						class="block text-sm text-zinc-400 hover:text-white transition-colors duration-100"
					>{ b.Title }</button>
				}
			</div>
		</div>
	}
}

templ blockTree(blocks []database.GetBlocksByPageRow, parentId pgtype.UUID, depth int, pageId string, pages map[string]string, balances []database.GetPocketBalancesRow, txByPocket map[string][]database.GetTransactionsWithPocketNamesRow) {
	if parentId == (pgtype.UUID{}) && len(blockChildren(blocks, parentId)) == 0 {
		@blockEditor(database.GetBlocksByPageRow{Type: "text"}, pageId, 0, pages, balances, txByPocket)
	}

	for _, b := range blockChildren(blocks, parentId) {
		@blockEditor(b, pageId, depth, pages, balances, txByPocket)
		@blockTree(blocks, b.ID, depth+1, pageId, pages, balances, txByPocket)
	}
}

templ blockEditor(b database.GetBlocksByPageRow, pageId string, depth int, pages map[string]string, balances []database.GetPocketBalancesRow, txByPocket map[string][]database.GetTransactionsWithPocketNamesRow) {
	<div
		x-data={ rowProps(b, pageId, depth) }
		data-id={ b.ID.String() }
		data-depth={ strconv.Itoa(depth) }
		@dragenter.prevent="onDragEnter()"
		@dragover.prevent="onDragOver()"
		@drop="onDrop()"
		class="group relative flex items-start"
	>
		<div
			draggable="true"
			@dragstart="onDragStart()"
			@dragend="onDragEnd()"
			title="drag to reorder"
			class="mr-1 hidden cursor-grab select-none px-0.5 pt-0.5 text-zinc-600 group-hover:flex hover:text-zinc-300"
		>⠿</div>
		<button
			@click="toggleMenu()"
			title="block type"
			class="mr-1 hidden cursor-pointer select-none px-0.5 pt-0.5 text-zinc-600 group-hover:flex hover:text-zinc-300"
		>+</button>
		<button
			@click="remove($root)"
			title="delete block"
			class="mr-1 hidden cursor-pointer select-none px-0.5 pt-0.5 text-zinc-600 group-hover:flex hover:text-red-400"
		>×</button>
		if b.Type == "table" {
			@blockTable(b, pageId, depth)
		} else if b.Type == "finance" {
			@blockFinance(b, pageId, balances, txByPocket)
		} else if b.Type == "list" {
			@blockList(b, pageId, depth)
		} else {
			<div
				x-data={ editorProps(b, pageId, depth) }
				contenteditable="true"
				spellcheck="false"
				data-placeholder="Type / for blocks"
				@focus="onFocus()"
				@blur="onBlur()"
				@input="onInput()"
				@keydown="onKeydown($event)"
				class={ editorClass(b.Type, depth) }
			>
				@blockText(b.Content, pages)
			</div>
		}
		@slashMenu()
	</div>
}

templ slashMenu() {
	<div
		x-show="menu"
		@click.away="closeSlash($root)"
		class="absolute left-6 top-6 z-10 mt-1 w-48 rounded-lg border border-zinc-800 bg-zinc-950 py-1 text-sm shadow-xl"
	>
		<template x-for="(t, i) in blockTypesList.filter(x => x !== menuType && (!menuFilter || x.includes(menuFilter)))" :key="t">
			<button
				:class="i === menuIndex ? 'bg-zinc-800' : ''"
				@mousedown.prevent="pickSlashType($root, t)"
				class="block w-full px-3 py-1 text-left text-zinc-300 hover:bg-zinc-800"
			>
				<span x-text="t" class="capitalize"></span>
			</button>
		</template>
	</div>
}

templ blockList(b database.GetBlocksByPageRow, pageId string, depth int) {
	<div
		x-data={ editorProps(b, pageId, depth) }
		contenteditable="true"
		spellcheck="false"
		@focus="onFocus()"
		@blur="onBlur()"
		@input="onInput()"
		@keydown="onKeydown($event)"
		class={ "block-editor outline-none cursor-text py-0.5 list-none" + indent(depth) }
	>
		<ul class="ml-4 list-disc">
			for _, item := range listItems(b.Content) {
				<li>{ item }</li>
			}
		</ul>
	</div>
}

templ blockTable(b database.GetBlocksByPageRow, pageId string, depth int) {
	<div class={ "w-full" + indent(depth) }>
		@blockTableGrid(b.Content)
	</div>
}

templ blockTableGrid(content []byte) {
	<table class="w-full border-collapse border border-zinc-800 text-sm">
		for _, row := range tableGrid(content) {
			<tr>
				for _, cell := range row {
					<td
						contenteditable="true"
						spellcheck="false"
						@input="tableInput($root)"
						@keydown.tab.prevent="tableTab($root)"
						class="min-w-16 border border-zinc-800 px-2 py-1 outline-none focus:bg-zinc-900"
					>{ cell }</td>
				}
			</tr>
		}
	</table>
	<div class="mt-1 flex gap-2 text-xs text-zinc-500">
		<button @click="tableAddRow($root)" class="cursor-pointer hover:text-zinc-300">+ row</button>
		<button @click="tableAddCol($root)" class="cursor-pointer hover:text-zinc-300">+ column</button>
		<button @click="tableDelRow($root)" class="cursor-pointer hover:text-red-400">− row</button>
		<button @click="tableDelCol($root)" class="cursor-pointer hover:text-red-400">− column</button>
	</div>
}

templ blockFinance(b database.GetBlocksByPageRow, pageId string, balances []database.GetPocketBalancesRow, txByPocket map[string][]database.GetTransactionsWithPocketNamesRow) {
	<div x-data={ financeProps(b, pageId) } class="my-2 rounded-lg border border-zinc-800">
		<div class="flex items-center gap-3 bg-zinc-900/50 px-3 py-2">
			<span class="text-xs uppercase tracking-wide text-zinc-500">Balance</span>
			<select
				x-ref="pocketSelect"
				@change="change()"
				class="rounded-lg border border-zinc-800 bg-zinc-950 px-2 py-1 text-sm outline-none focus:border-zinc-600"
			>
				<option value="">— choose pocket —</option>
				for _, p := range balances {
					<option value={ p.ID.String() }>{ p.Name } · { blockMoney(p.Balance) }</option>
				}
			</select>
			<span class="text-sm text-zinc-300">{ balanceLabel(b.Content, balances) }</span>
		</div>
		if pocket := financeBlockValue(b.Content); pocket != "" {
			<div class="divide-y divide-zinc-800/60">
				<div class="flex items-center gap-2 px-3 py-1.5">
					<input
						x-ref="txTitle"
						placeholder="Title"
						class="min-w-0 flex-1 border border-zinc-800 bg-zinc-950 px-2 py-1 text-sm outline-none focus:border-zinc-600"
					/>
					<select
						x-ref="txType"
						@change="txType = $el.value"
						class="rounded border border-zinc-800 bg-zinc-950 px-1 py-1 text-xs text-zinc-400 outline-none focus:border-zinc-600"
					>
						<option value="expense">expense</option>
						<option value="income">income</option>
					</select>
					<input
						x-ref="txAmount"
						type="number"
						step="0.01"
						min="0"
						placeholder="0.00"
						class="w-24 border border-zinc-800 bg-zinc-950 px-2 py-1 text-sm outline-none focus:border-zinc-600"
					/>
					<input
						x-ref="txDate"
						type="date"
						class="rounded border border-zinc-800 bg-zinc-950 px-1 py-1 text-xs text-zinc-400 outline-none focus:border-zinc-600"
					/>
					<button @click="addTx()" class="cursor-pointer rounded border border-zinc-700 px-2 py-1 text-xs text-zinc-300 hover:border-zinc-500 hover:text-zinc-100">+ add</button>
				</div>
				for _, tx := range txByPocket[pocket] {
					<div class="flex items-center justify-between px-3 py-1.5 text-sm">
						<span class="text-zinc-300">{ tx.Title }</span>
						<span class={ "text-right whitespace-nowrap " + txAmountColor(tx.Type) }>
							{ txSignedAmount(tx.Type, tx.Amount) } · { txDate(tx.Date) }
						</span>
					</div>
				}
				if len(txByPocket[pocket]) == 0 {
					<p class="px-3 py-1.5 text-xs text-zinc-500">No transactions</p>
				}
			</div>
		}
	</div>
}

templ blockText(content []byte, pages map[string]string) {
	for _, seg := range linkSegments(blockTextValue(content), pages) {
		if seg.id != "" {
			<a
				href="#"
				@mousedown.prevent="onLinkMousedown()"
				@click.prevent={ "loadContent('" + seg.id + "')" }
				class="text-blue-400 underline decoration-zinc-700 underline-offset-2 hover:text-blue-300"
			>{ seg.text }</a>
		} else {
			{ seg.text }
		}
	}
}

func blockChildren(blocks []database.GetBlocksByPageRow, parentId pgtype.UUID) []database.GetBlocksByPageRow {
	var children []database.GetBlocksByPageRow

	for _, b := range blocks {
		if b.ParentBlockID == parentId {
			children = append(children, b)
		}
	}

	return children
}

func blockTextValue(content []byte) string {
	var c struct {
		Text string `json:"text"`
	}
	if err := json.Unmarshal(content, &c); err != nil {
		return ""
	}

	return c.Text
}

var linkPattern = regexp.MustCompile(`\[\[([^\[\]]+)\]\]`)

func listItems(content []byte) []string {
	text := blockTextValue(content)
	if text == "" {
		return []string{""}
	}

	var items []string
	for _, line := range strings.Split(text, "\n") {
		if line != "" {
			items = append(items, line)
		}
	}

	if len(items) == 0 {
		return []string{""}
	}

	return items
}

func tableGrid(content []byte) [][]string {
	var c struct {
		Tables [][]string `json:"tables"`
	}
	if err := json.Unmarshal(content, &c); err != nil || len(c.Tables) == 0 {
		return [][]string{{""}}
	}

	return c.Tables
}

func financeBlockValue(content []byte) string {
	var c struct {
		Finance struct {
			Pocket string `json:"pocket"`
		} `json:"finance"`
	}
	if err := json.Unmarshal(content, &c); err != nil {
		return ""
	}

	return c.Finance.Pocket
}

func txSignedAmount(kind string, n pgtype.Numeric) string {
	f, err := n.Float64Value()
	if err != nil || !f.Valid {
		return ""
	}

	if kind == "expense" {
		return "-" + fmt.Sprintf("%.2f", f.Float64)
	}

	return "+" + fmt.Sprintf("%.2f", f.Float64)
}

func txAmountColor(kind string) string {
	if kind == "expense" {
		return "text-red-400"
	}

	return "text-emerald-400"
}

func txDate(d pgtype.Date) string {
	if !d.Valid {
		return ""
	}

	return d.Time.Format("2006-01-02")
}

type textSegment struct {
	text string
	id   string
}

func linkSegments(text string, pages map[string]string) []textSegment {
	segments := []textSegment{}
	pos := 0

	for _, m := range linkPattern.FindAllStringSubmatchIndex(text, -1) {
		if m[0] > pos {
			segments = append(segments, textSegment{text: text[pos:m[0]]})
		}

		segments = append(segments, textSegment{
			text: text[m[2]:m[3]],
			id:   pages[text[m[2]:m[3]]],
		})

		pos = m[1]
	}

	if pos < len(text) {
		segments = append(segments, textSegment{text: text[pos:]})
	}

	return segments
}

func editorProps(b database.GetBlocksByPageRow, pageId string, depth int) string {
	raw := blockTextValue(b.Content)
	return "editor({id: " + strconv.Quote(b.ID.String()) + ", type: " + strconv.Quote(b.Type) + ", pageId: " + strconv.Quote(pageId) + ", depth: " + strconv.Itoa(depth) + ", raw: " + strconv.Quote(raw) + "})"
}

func rowProps(b database.GetBlocksByPageRow, pageId string, depth int) string {
	return "row({id: " + strconv.Quote(b.ID.String()) + ", type: " + strconv.Quote(b.Type) + ", pageId: " + strconv.Quote(pageId) + ", depth: " + strconv.Itoa(depth) + "})"
}

func pageTagsProps(pageId string) string {
	return "pageTags({pageId: " + strconv.Quote(pageId) + "})"
}

func pageTitleProps(pageId, title string) string {
	return "pageTitle({pageId: " + strconv.Quote(pageId) + ", title: " + strconv.Quote(title) + "})"
}

func editorClass(t string, depth int) string {
	base := "block-editor outline-none cursor-text py-0.5"

	if depth > 0 {
		base += " ml-6"
	}

	if t == "heading" {
		return base + " pt-3 text-2xl font-semibold"
	}

	return base
}

func indent(depth int) string {
	if depth > 0 {
		return " ml-6"
	}

	return ""
}

func financeProps(b database.GetBlocksByPageRow, pageId string) string {
	pocket := financeBlockValue(b.Content)
	return "finance({id: " + strconv.Quote(b.ID.String()) + ", pageId: " + strconv.Quote(pageId) + ", pocket: " + strconv.Quote(pocket) + "})"
}

func blockMoney(n pgtype.Numeric) string {
	f, err := n.Float64Value()
	if err != nil {
		return ""
	}

	return fmt.Sprintf("%.2f", f.Float64)
}

func balanceLabel(content []byte, balances []database.GetPocketBalancesRow) string {
	pocket := financeBlockValue(content)
	if pocket == "" {
		return ""
	}

	for _, p := range balances {
		if p.ID.String() == pocket {
			return blockMoney(p.Balance)
		}
	}

	return "—"
}